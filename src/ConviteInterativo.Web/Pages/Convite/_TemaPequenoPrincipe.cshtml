@model ConviteInterativo.Web.Pages.Convite.IndexModel

@Html.Raw(Model.TemaHtmlAntes)

@{
    var frase = ConviteInterativo.Web.Pages.Convite.IndexModel.FraseConvite(Model.Evento);
}
@if (frase is not null)
{
    <p class="pp-frase-convite">@Html.Raw(frase.Replace("\n", "<br />"))</p>
}

@Html.Raw(Model.TemaHtmlMeio)

<partial name="_ConfirmacaoConteudo" model="Model" />

@Html.Raw(Model.TemaHtmlDepois)

<script src="~/themes/pequeno-principe/confirmacao-ajax.js" defer></script>