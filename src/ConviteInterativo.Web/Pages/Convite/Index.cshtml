@page "/c/{token}"
@model ConviteInterativo.Web.Pages.Convite.IndexModel
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Evento.Nome</title>
    <link rel="stylesheet" href="~/themes/pequeno-principe/animacao.css" />
    <script>
        window.dadosConvite = @Json.Serialize(new
        {
            nomes = Model.Convidados.Select(c => ConviteInterativo.Web.Pages.Convite.IndexModel.NomeExibicao(c, Model.Convite.Nome)),
            evento = new
            {
                dataHora = Model.Evento.DataHora,
                endereco = Model.Evento.Endereco,
                linkMapa = Model.LinkMapaResolvido,
            },
            modo = Model.Convite.ModoConfirmacao.ToString(),
            convidados = Model.Convidados.Select(c => new
            {
                id = c.Id,
                nome = ConviteInterativo.Web.Pages.Convite.IndexModel.NomeExibicao(c, Model.Convite.Nome),
                status = c.Status.ToString(),
            }),
        });
    </script>
    <script src="~/themes/pequeno-principe/animacao.js" defer></script>
</head>
<body>
    <partial name="_TemaPequenoPrincipe" />
</body>
</html>
