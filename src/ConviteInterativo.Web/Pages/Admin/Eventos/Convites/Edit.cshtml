@page "/Admin/Eventos/{eventoId:int}/Convites/{id:int}/Edit"
@model ConviteInterativo.Web.Pages.Admin.Eventos.Convites.EditModel
@{
    ViewData["Title"] = "Editar Convite";
}

<nav class="breadcrumb">
    <a asp-page="/Admin/Eventos/Index">Eventos</a> ›
    @Model.Evento.Nome ›
    <a asp-page="Index" asp-route-eventoId="@Model.Evento.Id">Convites</a> ›
    Editar
</nav>

<h2>Editar Convite — @Model.Evento.Nome</h2>

<form method="post">
    <partial name="_ConviteForm" model="Model.Input" />
    <button type="submit" class="btn">Salvar</button>
</form>
