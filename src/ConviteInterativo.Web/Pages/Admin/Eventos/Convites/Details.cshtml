@page "/Admin/Eventos/{eventoId:int}/Convites/{id:int}/Details"
@model ConviteInterativo.Web.Pages.Admin.Eventos.Convites.DetailsModel
@{
    ViewData["Title"] = "Detalhes do Convite";
}

<nav class="breadcrumb">
    <a asp-page="/Admin/Eventos/Index">Eventos</a> ›
    @Model.Evento.Nome ›
    <a asp-page="Index" asp-route-eventoId="@Model.Evento.Id">Convites</a> ›
    @Model.Convite.Nome
</nav>

<h2>@Model.Convite.Nome</h2>

<section>
    <h3>Integrantes</h3>

    @if (Model.ErroConvidado is not null)
    {
        <p class="field-validation-error">@Model.ErroConvidado</p>
    }

    @if (Model.Convidados.Count == 0)
    {
        <p>Nenhum integrante cadastrado ainda.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Integrante</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var convidado in Model.Convidados)
                {
                    <tr>
                        <td>
                            <form method="post" asp-page-handler="Editar" class="inline-form">
                                <input type="hidden" name="convidadoId" value="@convidado.Id" />
                                <input type="text" name="nome" value="@convidado.Nome" placeholder="Nome" />
                                <input type="text" name="sobrenome" value="@convidado.Sobrenome" placeholder="Sobrenome" />
                                <button type="submit" class="btn">Salvar</button>
                            </form>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="Remover" class="inline-form">
                                <input type="hidden" name="convidadoId" value="@convidado.Id" />
                                <button type="submit" class="btn">Remover</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h4>Adicionar integrante</h4>
    <form method="post" asp-page-handler="Adicionar">
        <partial name="_ConvidadoForm" model="Model.NovoConvidado" />
        <button type="submit" class="btn">Adicionar</button>
    </form>
</section>

<section>
    <h3>Link do convite</h3>
    @if (Model.Convidados.Count == 0)
    {
        <button type="button" class="btn" disabled>Gerar link</button>
        <p>Adicione integrantes ao grupo antes de gerar o link.</p>
    }
    else
    {
        <button type="button" class="btn js-toggle-link" data-target="link-block">Gerar link</button>
        <div id="link-block" hidden>
            <code id="link-url">@Model.LinkPublico</code>
            <button type="button" class="btn btn-copy" data-link-target="link-url">Copiar</button>
        </div>
    }
</section>

<p>
    <a asp-page="Index" asp-route-eventoId="@Model.Evento.Id" class="btn">Voltar</a>
    <a asp-page="Edit" asp-route-eventoId="@Model.Evento.Id" asp-route-id="@Model.Convite.Id" class="btn">Editar</a>
</p>

<script src="~/js/copy-link.js"></script>
