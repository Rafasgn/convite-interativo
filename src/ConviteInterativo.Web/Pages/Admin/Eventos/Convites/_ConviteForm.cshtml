@model ConviteInterativo.Web.Pages.Admin.Eventos.Convites.ConviteInputModel
@using ConviteInterativo.Web.Data.Entities

<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

<label asp-for="Nome">Nome do grupo</label>
<input asp-for="Nome" placeholder="ex.: Família Silva" />
<span asp-validation-for="Nome" class="field-validation-error"></span>

<label asp-for="ModoConfirmacao">Modo de confirmação</label>
<select asp-for="ModoConfirmacao" asp-items="Html.GetEnumSelectList<ModoConfirmacao>()"></select>
<span asp-validation-for="ModoConfirmacao" class="field-validation-error"></span>
